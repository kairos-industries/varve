{
  "name": "temporal-atlas",
  "version": "0.3.0",
  "private": true,
  "description": "Time-layered memory for AI agents, served over MCP",
  "license": "MIT",
  "type": "module",
  "bin": {
    "temporal-atlas": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli/main.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "memory",
    "agents",
    "obsidian",
    "claude-code"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pomess/temporal-atlas.git"
  }
}
