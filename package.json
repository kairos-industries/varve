{
  "name": "varve",
  "version": "0.5.0",
  "private": true,
  "description": "Your coding agent's memory of past work, layered by time and by topic. MCP server for Claude Code, Codex and any MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "varve": "dist/cli/main.js",
    "temporal-atlas": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').chmodSync('dist/cli/main.js',0o755)\"",
    "typecheck": "tsc --noEmit -p test",
    "test": "vitest run --config test/vitest.config.ts",
    "test:watch": "vitest --config test/vitest.config.ts",
    "charts": "node docs/assets/charts.mjs"
  },
  "keywords": [
    "mcp",
    "memory",
    "agents",
    "obsidian",
    "claude-code",
    "codex",
    "semantic-search"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cross-spawn": "^7.0.6",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pomess/varve.git"
  }
}
