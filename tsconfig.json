{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "dist",
    "newLine": "lf",
    "types": [
      "node"
    ],
    "rootDir": "src"
  },
  "include": [
    "src"
  ]
}
